# Captured data - these belong in the lab notebook, not in git
scope_data/
*.csv
*.png
*.txt
# ...except the test goldens, which are expected output rather than captured data
!tests/golden/*.txt
# ...and the probe reports, which are the evidence the profile notes rest on.
# A claim about what an instrument does is worth what the transcript behind it
# is worth, so the transcripts live next to the claims.
!docs/*.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
